;;This moves jak to a provided coordinate example call
;;(tp-jak 0.0 12.0 32.32)
(defun tp-jak ((arg0 float)(arg1 float)(arg2 float))
  (set! (-> (target-pos 0) x) (meters arg0))
  (set! (-> (target-pos 0) y) (meters arg1))
  (set! (-> (target-pos 0) z) (meters arg2))
)

;;This returns true or false depending on if jak is within a provided distance from an actor
(defun close? ((actor-ename string) (dist float))
  (and 
    (process-by-ename actor-ename)
    (<= 
      (vector-vector-distance 
        (target-pos 0) 
        (-> (the process-drawable (process-by-ename actor-ename)) root trans)
        )
      dist
      )
    )
  )


;;This returns true or false if jak is within a bubble defined by coordiantes and width
(defun in-bubble? ((x float) (y float) (z float) (w float))
  (<= 
    (vector-vector-distance 
      (target-pos 0) 
      (set-vector! (new-stack-vector0) x y z 1.0)
      )
    (/ w 2.0)
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Jak Color functions
;;;;;;;;;;;;;;;;;;;;;;;;;;
(defun draw-xyz ((jak target) (x float) (y float) (z float))
  (set! (-> jak draw color-mult x) x)
  (set! (-> jak draw color-mult y) y)
  (set! (-> jak draw color-mult z) z)
)
(defun draw-normal ((jak target))
  (draw-xyz jak 1.0 1.0 1.0)
)
(defun draw-white ((jak target))
  (draw-xyz jak 10.0 10.0 10.0)
)
(defun draw-black ((jak target))
  (draw-xyz jak 0.0 0.0 0.0)
)
(defun draw-red ((jak target))
  (draw-xyz jak 3.0 0.0 0.0)
)
(defun draw-green ((jak target))
  (draw-xyz jak 0.0 3.0 0.0)
)
(defun draw-blue ((jak target))
  (draw-xyz jak 0.0 0.0 3.0)
)
(defun draw-yellow ((jak target))
  (draw-xyz jak 3.0 3.0 0.0)
)
(defun draw-pink ((jak target))
  (draw-xyz jak 3.0 0.0 3.0)
)
(defun draw-light-blue ((jak target))
  (draw-xyz jak 0.0 3.0 3.0)
)

;; Helper functions for spawning orbs (used by orb placer in debug mode)

(defun spawn-skill ((vec vector) (amount float) (bob? symbol))
  (let ((fax (new 'static 'fact-info)))
    (set! (-> fax pickup-type) (pickup-type skill))
    (set! (-> fax pickup-amount) amount)
    (set! (-> fax pickup-spawn-amount) amount)
    ;; make sure it doesn't timeout and disappear
    (logior! (-> fax options) (actor-option fade-out))
    (set! (-> fax fade-time) (the-as time-frame 0))
    
    (let ((proc (the skill (ppointer->process (birth-pickup-at-point vec (pickup-type skill) amount #t *active-pool* fax)))))
      (when bob? 
        (set! (-> proc bob-amount) 1024.0)
        )
      (format 0 "spawned ~A~%" proc)
      ;; return handle to the orb
      (process->handle proc)
      )
    )
  )

(defun spawn-skill-meters ((x float) (y float) (z float) (amount float) (bob? symbol))
  (let ((vec (new 'stack-no-clear 'vector)))
    (set-vector-meters! vec x y z)
    (spawn-skill vec amount bob?)
    )
  )

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; defend the portwall stuff
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun in-bubble-m? ((x float) (y float) (z float) (w float))
  (in-bubble? (meters x) (meters y) (meters z) (meters w))
  )

(define *started-torn-cutscene?* #f) ;; Flag to check if Torn cutscene has started

(defun portblmp-hacks ()
  ;; Hack that allows portblmp to be loaded when you are in the city port
  (when (and (task-closed? "city-protect-blimp-introduction") (not (task-closed? "consite-find-baron-resolution")))
    ;; Load portblmp
    (when (and (= (-> (level-get-target-inside *level*) name) 'ctyport) (in-bubble-m? 625.18 4.29 1844.98 250.0) (!= (level-status *level* 'portblmp) 'active))
      (let ((a1-0 (new 'stack-no-clear 'array 'symbol 6)))
        (set! (-> a1-0 5) #f)
        (set! (-> a1-0 4) #f)
        (set! (-> a1-0 3) 'ctyport)
        (set! (-> a1-0 2) 'ctywide)
        (set! (-> a1-0 1) 'portblmp)
        (set! (-> a1-0 0) #f)
        (want-levels *load-state* a1-0)
        (want-display-level *load-state* 'portblmp 'display)
        (want-display-level *load-state* 'ctywide 'display)
        (want-display-level *load-state* 'ctyport 'display)
        )
      (let ((a1-3 (new 'stack-no-clear 'array 'symbol 3))) ;; sound banks for portblmp
        (set! (-> a1-3 2) 'drill1)
        (set! (-> a1-3 1) 'ctywide1)
        (set! (-> a1-3 0) 'ctywide2)
        (want-sound-banks *load-state* a1-3)
        )
      )
    ;; Fix ctypal not loading when you pass in a specific path
    (when (and (= (-> (level-get-target-inside *level*) name) 'ctyport) (= (level-status *level* 'portblmp) 'active))
      (when (or (in-bubble-m? 190.12 17.28 1750.20 450.0) (in-bubble-m? 270.44 3.81 1507.51 450.0))
        (let ((a1-0 (new 'stack-no-clear 'array 'symbol 6)))
          (set! (-> a1-0 5) #f)
          (set! (-> a1-0 4) #f)
          (set! (-> a1-0 3) 'ctyport)
          (set! (-> a1-0 2) 'ctywide)
          (set! (-> a1-0 1) 'ctypal)
          (set! (-> a1-0 0) #f)
          (want-levels *load-state* a1-0)
          (want-display-level *load-state* 'ctypal 'display)
          (want-display-level *load-state* 'ctywide 'display)
          (want-display-level *load-state* 'ctyport 'display)
          )
        (let ((a1-3 (new 'stack-no-clear 'array 'symbol 3))) ;; sound banks for ctywide
          (set! (-> a1-3 2) 'ctywide4)
          (set! (-> a1-3 1) 'ctywide5)
          (set! (-> a1-3 0) 'ctywide2)
          (want-sound-banks *load-state* a1-3)
          )
        )
      )
    ;; Load ctywide sound banks back in a specific spot
    (when (and (= (-> (level-get-target-inside *level*) name) 'ctyport) (= (level-status *level* 'portblmp) 'active))
      (when (in-bubble-m? 625.57 7.72 1597.09 150.0)
        (let ((a1-3 (new 'stack-no-clear 'array 'symbol 3))) ;; sound banks for ctywide
          (set! (-> a1-3 2) 'ctywide4)
          (set! (-> a1-3 1) 'ctywide5)
          (set! (-> a1-3 0) 'ctywide2)
          (want-sound-banks *load-state* a1-3)
          )
        )
      )
    )

  ;; Play custom audio during mission cutscene 
  (cond
    ((and (= (level-status *level* 'portblmp) 'active) (not *started-torn-cutscene?*) (real-movie?))
      (if (not (is-any-sound-playing?))
        (play-sound-file "CIPBRES.wav" (the int (* (-> *setting-control* user-default dialog-volume) 100.0)))
        (set! *started-torn-cutscene?* #t)
        )
      )
    ((and *started-torn-cutscene?* (not (real-movie?)))
      (set! *started-torn-cutscene?* #f)
      (stop-all-sounds)
      )
    )
        
  ;; Spawn or deactivate `portblmp-subt-manager` process
  (cond
    ((= (level-status *level* 'portblmp) 'active)
      (when (not *portblmp-subt-manager*)
        (set! *portblmp-subt-manager* (process-spawn portblmp-subt-manager :name "portblmp-subt-manager" :to *active-pool*))
        )
      )
    (else
      (when *portblmp-subt-manager*
        (deactivate (ppointer->process *portblmp-subt-manager*))
        (set! *portblmp-subt-manager* #f)
        )
      )
    )
  (none)
  )
  
;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CUSTOM TASKS.
;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Fix compiler error that don't know these enemy types due to Task-control.gc being compiled before the code for these enemies
(declare-type amphibian nav-enemy)
(declare-type metalmonk nav-enemy)
(declare-type fodder nav-enemy)

(defun custom-tasks-hacks ()
  ;; Pumping Station custom task
  (when (= (level-status *level* 'atoll) 'active)
    ;; hack to force actors to spawn
    (when (and (task-closed? "atoll-destroy-turrets-introduction") (not (task-closed? "atoll-destroy-turrets-resolution")))
      ;; SPYDER
      (when (entity-by-type spyder)
        (logclear! (-> (entity-by-name "spyder-53") extra kill-mask) (task-mask done task1 task2 task3)) ;; spyder-53
        (logclear! (-> (entity-by-name "spyder-2") extra kill-mask) (task-mask done task1 task2 task3)) ;; spyder-2
        (logclear! (-> (entity-by-name "spyder-3") extra kill-mask) (task-mask done task1 task2 task3)) ;; spyder-3
        (logclear! (-> (entity-by-name "spyder-4") extra kill-mask) (task-mask done task1 task2 task3)) ;; spyder-4
        )
      ;; AMPHIBIAN
      (when (entity-by-type amphibian)
        (logclear! (-> (entity-by-name "amphibian-1") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-1
        (logclear! (-> (entity-by-name "amphibian-2") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-2
        (logclear! (-> (entity-by-name "amphibian-4") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-4
        (logclear! (-> (entity-by-name "amphibian-48") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-48
        (logclear! (-> (entity-by-name "amphibian-49") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-49
        (logclear! (-> (entity-by-name "amphibian-46") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-46
        (logclear! (-> (entity-by-name "amphibian-50") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-50
        (logclear! (-> (entity-by-name "amphibian-47") extra kill-mask) (task-mask done task1 task2 task3)) ;; amphibian-47
        )
      ;; JUICER
      (when (entity-by-type juicer)
        (logclear! (-> (entity-by-name "juicer-12") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-12
        (logclear! (-> (entity-by-name "juicer-13") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-13
        (logclear! (-> (entity-by-name "juicer-81") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-81
        (logclear! (-> (entity-by-name "juicer-82") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-82
        (logclear! (-> (entity-by-name "juicer-8") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-8
        (logclear! (-> (entity-by-name "juicer-76") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-76
        (logclear! (-> (entity-by-name "juicer-77") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-77
        (logclear! (-> (entity-by-name "juicer-78") extra kill-mask) (task-mask done task1 task2 task3)) ;; juicer-78
        )
      ;; METALMONK
      (when (entity-by-type metalmonk)
        (logclear! (-> (entity-by-name "metalmonk-5") extra kill-mask) (task-mask done task1 task2 task3)) ;; metalmonk-5
        (logclear! (-> (entity-by-name "metalmonk-34") extra kill-mask) (task-mask done task1 task2 task3)) ;; metalmonk-34
        (logclear! (-> (entity-by-name "metalmonk-35") extra kill-mask) (task-mask done task1 task2 task3)) ;; metalmonk-35
        )
      ;; FODDER
      (when (entity-by-type fodder)
        (logclear! (-> (entity-by-name "fodder-114") extra kill-mask) (task-mask done task1 task2 task3)) ;; fodder-114
        (logclear! (-> (entity-by-name "fodder-18") extra kill-mask) (task-mask done task1 task2 task3)) ;; fodder-18
        (logclear! (-> (entity-by-name "fodder-111") extra kill-mask) (task-mask done task1 task2 task3)) ;; fodder-111
        (logclear! (-> (entity-by-name "fodder-112") extra kill-mask) (task-mask done task1 task2 task3)) ;; fodder-112
        )

      ;; REGION HACKS
      (let* ((region-124 (region-lookup-by-id 124))
             (region-20 (region-lookup-by-id 20))
             )
        (set! (-> region-124 on-inside) (the-as pair '(setting-pers calm mode #f)))
        )
      )
    )
         
    ;; checker for atoll custom task (close the task after all turrets have been destroyed and after leaving from atoll)
    (when (task-closed? "atoll-destroy-turrets-turn-on-valve")
      (when (!= (-> (level-get-target-inside *level*) name) 'atoll)
        (task-node-close! (game-task-node atoll-destroy-turrets-resolution))
        )
      )

    ;; checker for sewer custom task (close the task after protecting Sig and after leaving from sewer)
    (when (task-closed? "sewer-sig-protect")
      (when (!= (-> (level-get-target-inside *level*) name) 'sewesc)
        (task-node-close! (game-task-node sewer-sig-resolution))
        )
      )
  (none)
  )